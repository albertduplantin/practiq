# Firebase Configuration
# Obtenez ces valeurs depuis votre console Firebase (https://console.firebase.google.com)
# Allez dans Paramètres du projet > Général > Vos applications > Configuration SDK

# Clé API Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here

# Domaine d'authentification Firebase
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com

# ID du projet Firebase
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Bucket de stockage Firebase
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ID de l'expéditeur de messagerie Firebase
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# ID de l'application Firebase
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ID de mesure Firebase (optionnel - pour Google Analytics)
# Note: Si vous ne l'utilisez pas, laissez la valeur vide ou supprimez cette ligne
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-measurement-id
